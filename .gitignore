# Track project source, notebooks, tests, templates, configuration, requirements,
# documentation, and licenses by default. Keep the same relative directory layout
# on other machines; recreate environments and download datasets/weights there.

# Operating-system metadata and editor temporary files
.DS_Store
._*
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# Local Python environments
.venv/
.venv-*/
venv/
env/
.conda/

# Python bytecode, JIT caches, and tool caches
__pycache__/
*.py[cod]
*.nbc
*.nbi
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build and packaging outputs
build/
dist/
*.egg-info/
.eggs/
node_modules/

# Local environment settings (keep distributable templates)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Downloaded datasets and generated acquisition records; keep data documentation.
/data/**
!/data/**/
!/data/**/README*
!/data/**/LICENSE*

# Data-search downloads and metadata; retain the acquisition/search source code.
/data_catalog/**
!/data_catalog/**/
!/data_catalog/**/*.py
!/data_catalog/**/*.sh
!/data_catalog/**/*.ipynb
!/data_catalog/**/README*
!/data_catalog/**/LICENSE*
!/data_catalog/**/*license*.txt
!/data_catalog/**/*readme*.txt

# Model downloads, experiment results, and temporary working files
/models/
/artifacts/
/tmp/
/demonstration/outputs/

# Generated exports; retain LaTeX figure source for rebuilding documents.
/output/**
!/output/**/
!/output/**/*.tex

# Generated report audit records (keep report builders and templates)
/MantisV2_FineTune_Report/*.json
/Temporal_CrossTask_Report/*.json

# Data tables, binary arrays, model checkpoints, and duplicate source bundles
*.csv
*.tsv
*.xls
*.xlsx
*.npy
*.npz
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.joblib
*.pkl
*.pickle
*.onnx
*.zip

# LaTeX build products (keep .tex sources and source images)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.pdf
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
